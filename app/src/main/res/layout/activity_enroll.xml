<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <LinearLayout
        android:id="@+id/main"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".mvvm.enroll.EnrollActivity">




      <RelativeLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content">




          <ImageView
              android:layout_width="match_parent"
              android:layout_height="@dimen/dp_220"
              android:scaleType="fitXY"
              android:src="@drawable/enroll2" />
          <ImageView
              android:id="@+id/back"
              android:layout_width="35dp"
              android:layout_height="35dp"
              android:layout_margin="8dp"
              android:src="@drawable/back"/>
      </RelativeLayout>







        <EditText
            android:layout_margin="10dp"
            android:id="@+id/enroll_name"
            android:layout_width="300dp"
            android:background="@drawable/circle"
            android:padding="10dp"
            android:layout_gravity="center"
            android:layout_height="wrap_content"
            android:hint="请输入用户名" />

        <EditText
            android:layout_margin="10dp"
            android:id="@+id/eneoll_password"
            android:layout_width="300dp"
            android:background="@drawable/circle"
            android:padding="10dp"
             android:layout_gravity="center"
            android:layout_height="wrap_content"
            android:hint="请输入密码" />

        <EditText
            android:layout_margin="10dp"
            android:id="@+id/enroll_ok_password"
            android:layout_width="300dp"
            android:layout_gravity="center"
            android:layout_height="wrap_content"
            android:background="@drawable/circle"
            android:padding="10dp"
            android:hint="确认密码" />


         <LinearLayout
             android:layout_width="300dp"
             android:layout_margin="10dp"
             android:layout_gravity="center"
             android:layout_height="wrap_content">

             <EditText

                 android:layout_width="0dp"
                 android:layout_height="wrap_content"
                 android:id="@+id/enroll_code"
                 android:background="@drawable/circle"
                 android:padding="10dp"
                 android:hint="输入验证码"
                 android:layout_weight="15"/>
             <android.widget.Button
                 android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:hint="获取验证码"
                 android:background="@drawable/en"
                 android:layout_marginLeft="@dimen/dp_2"
                 android:id="@+id/enroll_getCode"/>




         </LinearLayout>





        <android.widget.Button
            android:enabled="false"
            android:layout_margin="15dp"
            android:id="@+id/enroll"
            android:layout_width="230dp"
            android:layout_gravity="center"
            android:background="@drawable/ok"
            android:textColor="#fff"
            android:layout_height="wrap_content"
            android:text="注册" />









    </LinearLayout>








</layout>